font-family = "MonoLisa Nerd Font"
font-style = "Regular"
font-family-italic = "MonoLisa"
font-style-italic = "Italic"
font-family-bold-italic = "MonoLisa"
font-style-bold-italic = "Bold Italic"
font-size=14
font-thicken = true

#background=444444
#background-opacity=0.45

background=000000
background-opacity=0.75
theme = Adventure

gtk-single-instance = false

keybind = ctrl+shift+t=new_window
keybind = ctrl+l=next_tab
keybind = ctrl+h=previous_tab
keybind = ctrl+shift+n=new_tab
